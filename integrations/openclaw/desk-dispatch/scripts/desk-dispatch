#!/usr/bin/env python3
"""Hand a coding task to an agent and let OpenClaw Docket follow it.

    desk-dispatch [--engine opencode|claude|codex] --title "<task name>" [-f BRIEF] [--model M] [--auto]
                  [--supersedes <handoff>] "<instruction>"

  opencode (default)  the Docket service opens the OpenCode session itself (archived, inbox prefix) and
                      hands it the instruction; with an OpenCode older than 2.2, or the service not
                      running, `opencode-dispatch --detach` starts it instead and Docket picks it up
  claude, codex       the Docket service starts the CLI agent in the current directory and follows it

--supersedes <handoff> redoes earlier work: the new handoff replaces that one, which Docket closes as
"replaced by …" (and stops, if it still runs). Use it instead of a second handoff for the same thing.

Returns as soon as the task is started. The caller gets no completion notice: Docket
verifies the delivery, writes briefs and sends follow-ups. Follow-ups never go through
this script.

Environment:
  DOCKET_ENGINE         default engine (else config.json "engine", else opencode)
  OPENCODE_DISPATCH   path to opencode-dispatch (default: the sibling OpenClaw skill)
  DOCKET_DISPATCH_VIA=opencode-dispatch   always start OpenCode work with opencode-dispatch
  DOCKET_DISPATCH_DRY_RUN=1   print what would happen
"""

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

HOME = Path(os.environ.get("DOCKET_HOME", Path.home() / "Library/Application Support/docket"))
ENGINES = {"opencode": "OpenCode", "claude": "Claude Code", "codex": "Codex"}


def fail(message: str, code: int = 2):
    print(f"desk-dispatch: {message}", file=sys.stderr)
    sys.exit(code)


def parse(argv):
    options = {"engine": None, "title": None, "brief": None, "model": None, "auto": False, "supersedes": None}
    rest = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("--engine", "--title", "-f", "--file", "--model", "-m", "--supersedes") and i + 1 < len(argv):
            key = {"-f": "brief", "--file": "brief", "-m": "model"}.get(arg, arg.lstrip("-"))
            options[key] = argv[i + 1]
            i += 2
            continue
        if arg.startswith(("--engine=", "--title=", "--model=", "--supersedes=")):
            key, value = arg[2:].split("=", 1)
            options[key] = value
        elif arg == "--auto":
            options["auto"] = True
        elif arg in ("-s", "--session", "-c", "--continue"):
            fail("follow-ups go through Docket, not this script")
        elif arg in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        elif arg.startswith("-"):
            fail(f"unknown option {arg}")
        else:
            rest.append(arg)
        i += 1
    options["instruction"] = " ".join(rest).strip()
    return options


def default_engine() -> str:
    if os.environ.get("DOCKET_ENGINE"):
        return os.environ["DOCKET_ENGINE"]
    try:
        return json.loads((HOME / "config.json").read_text(encoding="utf-8")).get("engine") or "opencode"
    except (OSError, ValueError):
        return "opencode"


def opencode(options):
    """Through the Docket service when it can drive this OpenCode; else opencode-dispatch, as before."""
    if os.environ.get("DOCKET_DISPATCH_VIA") != "opencode-dispatch" and os.environ.get("DOCKET_DISPATCH_DRY_RUN") != "1":
        answer = ask_docket(options, "opencode", fallback_ok=True)
        if answer is not None:
            print(f"dispatched in background: {options['title']} (handoff {answer['id']}, OpenCode){replaced(answer)}. Follow-ups happen on Docket.")
            return
        if options["supersedes"]:  # the new session is opencode-dispatch's: the old handoff closes now
            supersede(options)
    opencode_dispatch(options)


def replaced(answer) -> str:
    return f", replacing {answer['superseded']}" if answer.get("superseded") else ""


def service_call(path, body, timeout=60):
    """POST to the Docket service: (status, answer). status None when it is not running or not reachable."""
    try:
        service = json.loads((HOME / "daemon.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None, {"error": "the Docket service is not running (no daemon.json)"}
    request = urllib.request.Request(
        service["url"] + path,
        data=json.dumps(body).encode("utf-8"),
        method="POST",
        headers={"Content-Type": "application/json", "X-Docket-Token": service["token"]},
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.status, json.loads(response.read())
    except urllib.error.HTTPError as error:
        text = error.read().decode("utf-8", "replace")
        try:
            return error.code, json.loads(text)
        except ValueError:
            return error.code, {"error": text[:300]}
    except urllib.error.URLError as error:
        return None, {"error": f"the Docket service is not reachable: {error.reason}"}


def supersede(options):
    status, answer = service_call(f"/api/delegations/{options['supersedes']}/supersede", {"title": options["title"]})
    if status is None or status >= 300:
        fail(f"cannot replace {options['supersedes']}: {answer.get('error')}", 1)


def opencode_dispatch(options):
    script = os.environ.get("OPENCODE_DISPATCH") or str(Path(__file__).resolve().parents[2] / "opencode-dispatch/scripts/opencode-dispatch")
    if not Path(script).exists():
        script = "opencode-dispatch"
    argv = [script, "--detach", "--title", options["title"]]
    if options["auto"]:
        argv.append("--auto")
    if options["brief"]:
        argv += ["-f", options["brief"]]
    if options["model"]:
        argv += ["--model", options["model"]]
    argv.append(options["instruction"] or "Follow the attached brief.")
    if os.environ.get("DOCKET_DISPATCH_DRY_RUN") == "1":
        print(" ".join(argv))
        sys.exit(0)
    os.execvp(argv[0], argv)


def ask_docket(options, engine, fallback_ok=False):
    """POST /api/dispatch. None when the caller should start it another way (fallback_ok only):
    the service is not running, or it answers that this OpenCode goes through opencode-dispatch."""
    brief = ""
    if options["brief"]:
        try:
            brief = Path(options["brief"]).expanduser().read_text(encoding="utf-8")
        except OSError as error:
            fail(f"cannot read the brief: {error}")
    body = {
        "engine": engine,
        "title": options["title"],
        "directory": os.getcwd(),
        "instruction": options["instruction"] or "Follow the attached brief.",
        "brief": brief,
        "model": options["model"],
        "supersedes": options["supersedes"],
    }
    status, answer = service_call("/api/dispatch", body)
    if status is None:
        if fallback_ok and not options["supersedes"]:
            return None
        fail(answer["error"], 1)
    if status == 409 and fallback_ok and answer.get("fallback"):  # this OpenCode is started by opencode-dispatch
        return None
    if status >= 300:  # an unknown --supersedes id among them: nothing was started
        fail(f"Docket refused: {answer.get('error')}", 1)
    return answer


def cli(options, engine):
    if os.environ.get("DOCKET_DISPATCH_DRY_RUN") == "1":
        print(json.dumps({"engine": engine, "title": options["title"], "directory": os.getcwd(),
                          "instruction": options["instruction"] or "Follow the attached brief."}, ensure_ascii=False))
        sys.exit(0)
    result = ask_docket(options, engine)
    print(f"dispatched in background: {options['title']} (handoff {result['id']}, {ENGINES[engine]}){replaced(result)}. Follow-ups happen on Docket.")


def main():
    options = parse(sys.argv[1:])
    if not options["title"] or not options["title"].strip():
        fail('a task needs --title "<task name>"')
    if not options["instruction"] and not options["brief"]:
        fail("give an instruction or a brief file (-f)")
    engine = options["engine"] or default_engine()
    if engine not in ENGINES:
        fail(f"unknown engine {engine} (opencode, claude, codex)")
    if engine == "opencode":
        opencode(options)
    else:
        cli(options, engine)


if __name__ == "__main__":
    main()
